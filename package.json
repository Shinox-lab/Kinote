{
  "name": "living-wiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "web": "pnpm --filter @living-wiki/web run dev",
    "web:build": "pnpm --filter @living-wiki/web run build",
    "build": "echo \"build is not available until Task 2.6\" && exit 1",
    "dev": "echo \"dev is not available until Task 2.6\" && exit 1",
    "start": "echo \"start is not available until Task 2.6\" && exit 1",
    "test": "vitest run",
    "live-check": "node scripts/run-live-check.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx packages/db/src/migrate.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
