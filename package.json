{
  "name": "living-wiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/dev.mjs",
    "start": "node scripts/dev.mjs",
    "web": "pnpm --filter @living-wiki/web run dev",
    "web:build": "pnpm --filter @living-wiki/web run build",
    "test": "node scripts/run-tests.mjs",
    "live-check": "node scripts/run-live-check.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate"
  },
  "engines": {
    "node": ">=18.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@types/node": "^24.10.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3"
  }
}
