{
  "name": "living-wiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "web": "pnpm --filter @living-wiki/web run dev",
    "web:build": "pnpm --filter @living-wiki/web run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "test:pg": "vitest run -c vitest.pg.config.ts",
    "stack:up": "bash infra/stack-up.sh",
    "stack:down": "bash infra/stack-down.sh",
    "e2e": "bash infra/e2e.sh",
    "e2e:local": "E2E_MODE=local playwright test",
    "start:api": "tsx apps/api/src/main.ts",
    "start:collab": "tsx apps/collab/src/main.ts",
    "start:worker": "tsx apps/worker/src/main.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.10.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
