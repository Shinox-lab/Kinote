# Copy to .env and fill in every empty value. Never commit real secrets.
# Secrets are deliberately empty here: loadConfig rejects a missing or short
# secret and docker-compose.yml refuses to start without them, so a copied
# example can never run with a shared default.
#
# Values below that name 127.0.0.1:55543 / :59000 point at the local stack
# from docker-compose.yml (`pnpm stack:up`); inside compose the services use
# their own internal URLs. See docs/operations.md.

# --- Postgres -------------------------------------------------------------
# Superuser password of the compose postgres container.
POSTGRES_PASSWORD=
# Password of the living_wiki_app login role (created by
# infra/postgres/01-roles.sh on first start of the postgres container).
APP_DB_PASSWORD=

# Runtime connection for api, collab and worker: the living_wiki_app role
# (LOGIN, NOSUPERUSER, NOBYPASSRLS). Row-level security is enforced for it.
# Local stack: postgres://living_wiki_app:<APP_DB_PASSWORD>@127.0.0.1:55543/living_wiki
DATABASE_URL=

# Used only by `pnpm db:migrate`, never at runtime. Must be a superuser or a
# BYPASSRLS role that owns the schema: row-level security is FORCED on every
# table, and the SECURITY DEFINER functions (my_tenants,
# tenants_with_due_jobs) run as the migration owner and read across tenants.
# Local stack: postgres://postgres:<POSTGRES_PASSWORD>@127.0.0.1:55543/living_wiki
DATABASE_MIGRATE_URL=

# Real-Postgres test suite (`pnpm test:pg`): it fails at once unless both are
# set (the plain `pnpm vitest run` never runs the *.pg.test.ts files). Same
# roles as above, against the local stack:
#   TEST_DATABASE_URL=postgres://living_wiki_app:<APP_DB_PASSWORD>@127.0.0.1:55543/living_wiki
#   TEST_DATABASE_MIGRATE_URL=postgres://postgres:<POSTGRES_PASSWORD>@127.0.0.1:55543/living_wiki
TEST_DATABASE_URL=
TEST_DATABASE_MIGRATE_URL=

# --- Secrets --------------------------------------------------------------
# Signing secrets, at least 32 random characters each.
COLLAB_TOKEN_SECRET=
INTERNAL_SECRET=

# --- Services -------------------------------------------------------------
# Host ports the local stack publishes on 127.0.0.1. Coolify does not need them:
# it routes the public domain to the web service's container port 80. Uncomment
# and change one when its default is taken.
# The console is the web service at http://localhost:${WEB_HOST_PORT}
# (`docker compose up -d`); API_HOST_PORT / COLLAB_HOST_PORT are used by
# `pnpm e2e` and the UI-only dev server, not by the web container.
# POSTGRES_HOST_PORT=55543
# MINIO_HOST_PORT=59000
# MINIO_CONSOLE_HOST_PORT=59001
# WEB_HOST_PORT=8080
# API_HOST_PORT=8787
# COLLAB_HOST_PORT=1234

# Where the api reaches the collab server, and the service ports.
COLLAB_INTERNAL_URL=http://127.0.0.1:1234
API_PORT=8787
COLLAB_PORT=1234
# Bind address of the api and collab servers (default 127.0.0.1, loopback
# only). docker-compose.yml sets 0.0.0.0 inside the containers.
HOST=127.0.0.1
# Which X-Forwarded-For hops the api trusts for the client IP the auth rate
# limit keys on: false (default, no proxy in front), or behind a proxy the
# number of proxies in front of the api (recommended, e.g. 1; behind Coolify set
# 2 because its proxy sits in front of the web nginx). `true` trusts
# every hop, so a client-supplied X-Forwarded-For can dodge the sign-in rate
# limit; `false` behind a proxy puts every user in one bucket. The edge proxy
# must overwrite or append X-Forwarded-For. See docs/operations.md.
TRUST_PROXY=false
# Per-IP sign-up and sign-in attempts per minute (each route counted
# separately). Raised only by `pnpm e2e`, which signs up many accounts.
AUTH_RATE_LIMIT_MAX=10
# Level of the api's JSON log on stdout (fatal, error, warn, info, debug,
# trace, silent; default info). Unexpected errors are logged at error; the
# session token, cookies, the internal secret and request bodies never are.
LOG_LEVEL=info

# Embeddings. The index is fixed at 2560 dimensions; this release has no
# dimension setting. Keep deterministic for local tests, or point at an
# OpenAI-compatible /embeddings server (for example Qwen3-Embedding-8B).
EMBEDDING_PROVIDER=deterministic
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Inputs per /embeddings request.
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_MS=30000
# Qwen query-side instruction, applied only to search/Ask queries. Leave empty
# for providers that do not use one.
EMBEDDING_QUERY_INSTRUCTION=

# Ask. deterministic keeps the quoted-passage answer for local/e2e; openai
# uses an OpenAI-compatible /chat/completions model. A model failure is a 503,
# never a silent fallback.
ASK_PROVIDER=deterministic
ASK_BASE_URL=
ASK_API_KEY=
ASK_MODEL=
ASK_TIMEOUT_MS=60000
ASK_MAX_TOKENS=800

# Routing model: page cards, entity extraction and capture routing. The worker
# refuses deterministic when embeddings or Ask use a real model.
# deterministic for local/e2e; openai uses an OpenAI-compatible
# /chat/completions model that can answer JSON objects. Failures retry as jobs.
ROUTER_PROVIDER=deterministic
ROUTER_BASE_URL=
ROUTER_API_KEY=
ROUTER_MODEL=
ROUTER_TIMEOUT_MS=60000
ROUTER_MAX_TOKENS=2000
# off: ask a reasoning model (e.g. on OpenRouter) not to think first. Its thinking
# counts toward ROUTER_MAX_TOKENS and can use it all up before the answer.
ROUTER_REASONING=

# --- Object storage (S3 / MinIO) ------------------------------------------
# The compose stack defaults to its bundled MinIO (http://minio:9000 inside the
# network); set an external S3 endpoint here for production. The access and
# secret keys are also the MinIO root credentials when the bundled MinIO is used.
# Setting S3_ENDPOINT also enables the S3 case of
# packages/shared/test/objectStorage.test.ts, which creates S3_BUCKET if missing.
S3_ENDPOINT=
S3_BUCKET=living-wiki
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# --- Files ------------------------------------------------------------------
# Largest upload in bytes (default 50 MB, at most 500 MB).
MAX_UPLOAD_BYTES=52428800
# Most characters of text one file may yield; a file with more fails, it is never cut.
MAX_EXTRACTED_CHARS=2000000
# The compose stack always starts the Docling extractor; http uses it. `off` is
# a deliberate text/CSV-only run; `fake` is for the e2e suite.
EXTRACTOR_MODE=http
EXTRACTOR_URL=http://extractor:8000
# Must stay under the worker's 300 s job lease (at most 270000).
EXTRACTOR_TIMEOUT_MS=240000
