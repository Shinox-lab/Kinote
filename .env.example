# Copy to .env and replace every placeholder. Never commit real secrets.

# Runtime connection for api, collab and worker: the living_wiki_app role
# (LOGIN, NOSUPERUSER, NOBYPASSRLS). Row-level security is enforced for it.
DATABASE_URL=postgres://living_wiki_app:change-me@127.0.0.1:5432/living_wiki

# Schema owner, used only by `pnpm db:migrate`. Must be a superuser or have
# BYPASSRLS, because RLS is forced on every table. Never use it at runtime.
DATABASE_MIGRATE_URL=postgres://postgres:change-me@127.0.0.1:5432/living_wiki

# Signing secrets, at least 32 characters each.
COLLAB_TOKEN_SECRET=change-me-to-a-random-32+-character-string
INTERNAL_SECRET=change-me-to-a-random-32+-character-string

# Where the api reaches the collab server, and the service ports.
COLLAB_INTERNAL_URL=http://127.0.0.1:1234
API_PORT=8787
COLLAB_PORT=1234
# Bind address of the api (default 0.0.0.0).
HOST=0.0.0.0

# Embeddings. Dimensions must match the provider and the halfvec column (max 4000).
EMBEDDING_PROVIDER=deterministic
EMBEDDING_DIMENSIONS=1536

# Object storage (optional until the S3 adapter lands).
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
