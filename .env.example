# Copy to .env and fill in every empty value. Never commit real secrets.
# Secrets are deliberately empty here: loadConfig rejects a missing or short
# secret and docker-compose.yml refuses to start without them, so a copied
# example can never run with a shared default.
#
# Values below that name 127.0.0.1:55543 / :59000 point at the local stack
# from docker-compose.yml (`pnpm stack:up`); inside compose the services use
# their own internal URLs. See docs/operations.md.

# --- Postgres -------------------------------------------------------------
# Superuser password of the compose postgres container.
POSTGRES_PASSWORD=
# Password of the living_wiki_app login role (created by
# infra/postgres/01-roles.sh on first start of the postgres container).
APP_DB_PASSWORD=

# Runtime connection for api, collab and worker: the living_wiki_app role
# (LOGIN, NOSUPERUSER, NOBYPASSRLS). Row-level security is enforced for it.
# Local stack: postgres://living_wiki_app:<APP_DB_PASSWORD>@127.0.0.1:55543/living_wiki
DATABASE_URL=

# Used only by `pnpm db:migrate`, never at runtime. Must be a superuser or a
# BYPASSRLS role that owns the schema: row-level security is FORCED on every
# table, and the SECURITY DEFINER functions (my_tenants,
# tenants_with_due_jobs) run as the migration owner and read across tenants.
# Local stack: postgres://postgres:<POSTGRES_PASSWORD>@127.0.0.1:55543/living_wiki
DATABASE_MIGRATE_URL=

# Real-Postgres test suite (`pnpm test:pg`); the *.pg.test.ts files skip when
# TEST_DATABASE_URL is unset. Same roles as above, against the local stack:
#   TEST_DATABASE_URL=postgres://living_wiki_app:<APP_DB_PASSWORD>@127.0.0.1:55543/living_wiki
#   TEST_DATABASE_MIGRATE_URL=postgres://postgres:<POSTGRES_PASSWORD>@127.0.0.1:55543/living_wiki
TEST_DATABASE_URL=
TEST_DATABASE_MIGRATE_URL=

# --- Secrets --------------------------------------------------------------
# Signing secrets, at least 32 random characters each.
COLLAB_TOKEN_SECRET=
INTERNAL_SECRET=

# --- Services -------------------------------------------------------------
# Where the api reaches the collab server, and the service ports.
COLLAB_INTERNAL_URL=http://127.0.0.1:1234
API_PORT=8787
COLLAB_PORT=1234
# Bind address of the api (default 0.0.0.0).
HOST=0.0.0.0
# Set to true only behind a reverse proxy that sets X-Forwarded-For, so the
# auth rate limit keys on the real client IP (default false).
TRUST_PROXY=false
# Per-IP sign-up and sign-in attempts per minute (each route counted
# separately). Raised only by `pnpm e2e`, which signs up many accounts.
AUTH_RATE_LIMIT_MAX=10

# Embeddings. Dimensions must match the provider and the halfvec column (max 4000).
EMBEDDING_PROVIDER=deterministic
EMBEDDING_DIMENSIONS=1536

# --- Object storage (S3 / MinIO) ------------------------------------------
# Local stack MinIO: S3_ENDPOINT=http://127.0.0.1:59000; the access and secret
# keys are also the MinIO root credentials in docker-compose.yml. Setting
# S3_ENDPOINT also enables the S3 case of packages/shared/test/objectStorage.test.ts,
# which creates S3_BUCKET if it is missing.
S3_ENDPOINT=
S3_BUCKET=living-wiki
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
