{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@living-wiki/contracts": ["packages/contracts/src/index.ts"],
      "@living-wiki/core": ["packages/core/src/index.ts"],
      "@living-wiki/db/testing": ["packages/db/src/testing.ts"],
      "@living-wiki/db": ["packages/db/src/index.ts"],
      "@living-wiki/shared": ["packages/shared/src/index.ts"],
      "@living-wiki/api": ["apps/api/src/server.ts"],
      "@living-wiki/collab": ["apps/collab/src/server.ts"],
      "@living-wiki/worker": ["apps/worker/src/runner.ts"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "apps/**/*.ts",
    "apps/**/*.tsx"
  ],
  "exclude": [
    "dist/**",
    "node_modules/**"
  ]
}
